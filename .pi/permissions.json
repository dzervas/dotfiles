{
	"version": 2,
	"defaultAction": "ask",
	"allowRoots": [],
	"denyRoots": [],
	"rules": [
		{
			"action": "allow",
			"tool": {
				"kind": "builtin",
				"name": "^bash$"
			},
			"match": {
				"raw": ["nix (eval|flake metadata) ", "tsc"]
