# syntax=docker/dockerfile:1
FROM debian:trixie-slim AS download
ARG TARGETARCH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) \
        target=x86_64-unknown-linux-gnu; \
        sha=0cd2105aaf2de0f681338bda87c0866e8ce47b3d81da9a5effb15a4fdc04e202 ;; \
      arm64) \
        target=aarch64-unknown-linux-gnu; \
        sha=ec7f4f437b392ab43f856fcb39410b53965a969af77a981d460ad9fe2b4789f2 ;; \
      *) printf 'Unsupported architecture: %s\n' "$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 \
      "https://github.com/Microck/kagi-cli/releases/download/v0.20.1/kagi-v0.20.1-${target}" \
      -o /kagi; \
    printf '%s  /kagi\n' "$sha" | sha256sum -c -; \
    chmod 0755 /kagi

FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=download /kagi /usr/local/bin/kagi

ENV HOME=/tmp/kagi \
    XDG_CONFIG_HOME=/tmp/kagi/config \
    XDG_CACHE_HOME=/tmp/kagi/cache \
    XDG_DATA_HOME=/tmp/kagi/data

USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/kagi"]
CMD ["mcp"]

