FROM nvidia/cuda:13.0.3-devel-ubuntu24.04 AS base

RUN apt-get update \
      && apt-get install -y --no-install-recommends build-essential cmake git wget curl \
      && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /src

FROM base AS flint-build

ARG LLAMA_CPP_REV=0693dbfb915f33233818373b5f6969396658d02c
ARG BUILD_JOBS=8

RUN mkdir -p /src/flint
WORKDIR /src/flint

RUN  git init \
      && git remote add origin https://github.com/ggml-org/llama.cpp.git \
      && git fetch --depth 1 origin "${LLAMA_CPP_REV}" \
      && git checkout FETCH_HEAD

# CI's CPU may differ from the host that runs this image.
RUN cmake -B build \
      -DGGML_CUDA=ON \
      -DGGML_NATIVE=OFF \
      -DBUILD_SHARED_LIBS=OFF \
      -DLLAMA_BUILD_TESTS=OFF \
      -DLLAMA_BUILD_UI=OFF \
      -DLLAMA_USE_PREBUILT_UI=OFF \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES=120a-real

RUN cmake --build build --config Release -j"${BUILD_JOBS}" --target llama-server

# unified-cuda13 currently ships CUDA 13.3.1. Keep the CUDA 12.9 upstream
# binaries and install CUDA 13.0 alongside them for Flint/vLLM, rather than
# implicitly upgrading every backend to a newer CUDA minor version.
FROM ghcr.io/mostlygeek/llama-swap:unified-cuda

COPY --from=flint-build /src/flint/build/bin/llama-server /usr/local/bin/flint-server

RUN apt-get update \
      && apt-get install -y --no-install-recommends \
      build-essential \
      python3-dev \
      cuda-nvcc-13-0 \
      libcublas-13-0 \
      libcurand-dev-13-0 \
      && rm -rf /var/lib/apt/lists/*

ENV CC=/usr/bin/gcc
ENV CXX=/usr/bin/g++

# vLLM 0.32.0 defaults to CUDA 13.0; match Flint's build and the JIT toolkit.
# https://github.com/vllm-project/vllm/releases/tag/v0.32.0
ARG VLLM_VERSION=0.32.0
ENV UV_LINK_MODE=copy

# https://github.com/vllm-project/vllm/releases
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
      uv venv /opt/vllm --python /usr/bin/python3 && \
      uv pip install \
      --python /opt/vllm/bin/python \
      --torch-backend=cu130 \
      "vllm==${VLLM_VERSION}"

# Do not use /usr/local/cuda: the upstream image also has a CUDA 12 runtime.
ENV PATH="/opt/vllm/bin:/usr/local/cuda-13.0/bin:${PATH}"
ENV CUDA_HOME=/usr/local/cuda-13.0
ENV LD_LIBRARY_PATH="/usr/local/cuda-13.0/lib64:${LD_LIBRARY_PATH}"
ENV LLAMA_SWAP_WATCH_CONFIG='true'
