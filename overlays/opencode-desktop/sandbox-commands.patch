+// The server can see every project, so each command it spawns is confined to
+// its own project with sand, which mounts its working directory. They share
+// the server's /tmp, where tools exchange files with it.
+const sandboxed = (spawner: ChildProcessSpawner["Service"], project: string) =>
+  make((command) => {
+    if (command._tag !== "StandardCommand") return Effect.die(new Error("Piped commands are not sandboxed"))
+    const cwd = command.options.cwd ?? project
+    return spawner.spawn(
+      ChildProcess.make(
+        "@sand@",
+        ["--bind", "/tmp:/tmp", "-c", 'cd "$1" && shift && exec "$@"', "--", "--", cwd, command.command, ...command.args],
+        { ...command.options, cwd: project },
+      ),
+    )
+  })
+
