--- /dev/null
+++ b/src/acp/snapshot-read.ts
@@ -0,0 +1,13 @@
+import { spawnSync } from 'node:child_process'
+import { projectPath } from './project-path.js'
+
+export function readProjectSnapshot(cwd: string, path: string): string | null {
+  const command = process.env.PI_ACP_READ_COMMAND
+  if (!command || !projectPath(cwd, path))
+    throw new Error('Sandbox snapshot reader unavailable or path outside project')
+  const result = spawnSync(command, [path], { cwd, encoding: 'utf8', shell: false, timeout: 5_000 })
+  if (result.error) throw result.error
+  if (result.status === 44) return null
+  if (result.status !== 0) throw new Error('Sandbox snapshot read failed')
+  return result.stdout
+}
