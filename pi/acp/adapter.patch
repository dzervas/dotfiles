@@ -0,0 +1,106 @@
+import test from 'node:test'
+import { installMockSnapshotReader } from '../helpers/snapshot-reader.js'
+installMockSnapshotReader()
+import assert from 'node:assert/strict'
+import { mkdtempSync, mkdirSync, writeFileSync, symlinkSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { projectPath, sameProject } from '../../src/acp/project-path.js'
+import { PiAcpSession } from '../../src/acp/session.js'
+import { PiAcpAgent } from '../../src/acp/agent.js'
+import { PiRpcProcess } from '../../src/pi-rpc/process.js'
+import { FakeAgentSideConnection, FakePiRpcProcess, asAgentConn } from '../helpers/fakes.js'
+
+const tick = () => new Promise(resolve => setImmediate(resolve))
+test('canonical project boundary rejects outside paths and symlink parents, allows new project files', async () => {
+  const root = mkdtempSync(join(tmpdir(), 'pi-acp-isolation-'))
+  try {
+    const cwd = join(root, 'project')
+    mkdirSync(cwd)
+    const outside = join(root, 'outside')
+    mkdirSync(outside)
+    writeFileSync(join(outside, 'host-only'), 'host-only text')
+    symlinkSync(outside, join(cwd, 'escape'))
+    symlinkSync(cwd, join(root, 'alias'))
+    assert.equal(projectPath(cwd, '../outside/host-only'), null)
+    assert.equal(projectPath(cwd, 'escape/host-only'), null)
+    assert.equal(projectPath(cwd, 'escape/new/deep/file'), null)
+    assert.equal(projectPath(cwd, 'new/deep/file'), join(cwd, 'new/deep/file'))
+    assert.ok(sameProject(cwd, join(root, 'alias')))
+    assert.equal(sameProject(cwd, outside), false)
+    const proc = new FakePiRpcProcess()
+    const conn = new FakeAgentSideConnection()
+    new PiAcpSession({
+      sessionId: 's',
+      cwd,
+      mcpServers: [],
+      proc: proc as unknown as PiRpcProcess,
+      conn: asAgentConn(conn)
+    })
+    proc.emit({
+      type: 'tool_execution_start',
+      toolCallId: 'edit',
+      toolName: 'edit',
+      args: { path: 'escape/host-only' }
+    })
+    proc.emit({
+      type: 'tool_execution_end',
+      toolCallId: 'edit',
+      isError: false,
+      result: { content: [{ type: 'text', text: 'ok' }] }
+    })
+    await tick()
+    assert.ok(!JSON.stringify(conn.updates).includes('host-only text'))
+    assert.ok(!JSON.stringify(conn.updates).includes('"type":"diff"'))
+  } finally {
+    rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test('load rejects cwd mismatch before closing an existing process', async () => {
+  const agent = new PiAcpAgent(asAgentConn(new FakeAgentSideConnection()))
+  const internals = agent as unknown as { store: unknown; sessions: unknown }
+  internals.store = { get: () => ({ cwd: '/tmp/project-a', sessionFile: '/tmp/a.jsonl' }) }
+  internals.sessions = {
+    close: () => {
+      throw new Error('must not close')
+    }
+  }
+  await assert.rejects(agent.loadSession({ sessionId: 'a', cwd: '/tmp/project-b', mcpServers: [] }), /invalid params/i)
+})
+
+test('new sessions pass negotiated form capability and do not close other sessions', async () => {
+  const conn = new FakeAgentSideConnection()
+  const agent = new PiAcpAgent(asAgentConn(conn))
+  const created: Array<{ cwd: string; supportsForms: boolean }> = []
+  const closures: string[] = []
+  const internals = agent as unknown as { sessions: unknown }
+  internals.sessions = {
+    create: async (params: { cwd: string; supportsForms: boolean }) => {
+      created.push(params)
+      return {
+        sessionId: `s${created.length}`,
+        cwd: params.cwd,
+        proc: {
+          getState: async () => ({ model: { provider: 'p', id: 'm' }, thinkingLevel: 'medium' }),
+          getAvailableModels: async () => ({ models: [{ provider: 'p', id: 'm' }] }),
+          getAvailableThinkingLevels: async () => ['medium'],
+          getCommands: async () => ({ commands: [] }),
+          consumePreludeLines: () => []
+        },
+        setStartupInfo: () => {},
+        sendStartupInfoIfPending: () => {},
+        publishContextUsage: async () => {}
+      }
+    },
+    closeAllExcept: (id: string) => closures.push(id)
+  }
+  await agent.initialize({ protocolVersion: 1, clientCapabilities: { elicitation: { form: {} } } })
+  await agent.newSession({ cwd: '/tmp', mcpServers: [] })
+  await agent.newSession({ cwd: '/tmp', mcpServers: [] })
+  assert.deepEqual(
+    created.map(p => p.supportsForms),
+    [true, true]
+  )
+  assert.deepEqual(closures, [])
+})
diff --git a/test/unit/session-reload-lifecycle.test.ts b/test/unit/session-reload-lifecycle.test.ts
