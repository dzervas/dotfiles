+export function todoPlan(result: unknown, isError: unknown = false): SessionUpdate | null {
+  if (isError) return null
+  const tasks = record(record(result)?.details)?.tasks
+  if (!Array.isArray(tasks)) return null
+  const entries = []
+  for (const task of tasks) {
+    const item = record(task)
+    if (typeof item?.subject !== 'string' || !['pending', 'in_progress', 'completed'].includes(String(item.status)))
+      return null
+    entries.push({
+      content: item.subject,
+      status: item.status as 'pending' | 'in_progress' | 'completed',
+      priority: 'medium' as const
+    })
+  }
+  return { sessionUpdate: 'plan', entries }
+}
+
+// Walk the full active branch, not get_messages (which omits precompaction history).
+export function replayTodoPlan(data: unknown): SessionUpdate | null {
+  const state = record(data)
+  if (!Array.isArray(state?.entries) || typeof state.leafId !== 'string') return null
+  const entries = new Map(
+    state.entries.map(value => {
+      const entry = record(value)
+      return [entry?.id, entry] as const
+    })
+  )
+  const visited = new Set<string>()
+  let id: unknown = state.leafId
+  while (typeof id === 'string' && !visited.has(id)) {
+    visited.add(id)
+    const entry = entries.get(id)
+    if (!entry) break
+    const message = record(entry.message)
+    if (entry.type === 'message' && message?.role === 'toolResult' && message.toolName === 'todo') {
+      const plan = todoPlan(message, message.isError)
+      if (plan) return plan
+    }
+    id = entry.parentId
+  }
+  return null
+}
diff --git a/src/acp/project-path.ts b/src/acp/project-path.ts
new file mode 100644
index 0000000..38f18a4
--- /dev/null
+++ b/src/acp/project-path.ts
@@ -0,0 +1,32 @@
+import { realpathSync } from 'node:fs'
+import { dirname, isAbsolute, relative, resolve, sep } from 'node:path'
+
+function canonicalPath(path: string): string {
+  try {
+    return realpathSync(path)
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+    const parent = dirname(path)
+    if (parent === path) throw error
+    return resolve(canonicalPath(parent), relative(parent, path))
+  }
+}
+
+export function projectPath(cwd: string, path: string): string | null {
+  try {
+    const root = realpathSync(cwd)
+    const target = canonicalPath(resolve(cwd, path))
+    const rel = relative(root, target)
+    return rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel) ? null : target
+  } catch {
+    return null
+  }
+}
+
+export function sameProject(a: string, b: string): boolean {
+  try {
+    return realpathSync(a) === realpathSync(b)
+  } catch {
+    return resolve(a) === resolve(b)
+  }
+}
