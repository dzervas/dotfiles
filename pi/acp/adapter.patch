+import test, { type TestContext } from 'node:test'
+import assert from 'node:assert/strict'
+import { mkdtempSync, mkdirSync, writeFileSync, rmSync, symlinkSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { readProjectSnapshot } from '../../src/acp/snapshot-read.js'
+import { PiAcpSession } from '../../src/acp/session.js'
+import type { PiRpcProcess } from '../../src/pi-rpc/process.js'
+import { FakeAgentSideConnection, FakePiRpcProcess, asAgentConn } from '../helpers/fakes.js'
+
+function fixture(t: TestContext, body: string) {
+  const root = mkdtempSync(join(tmpdir(), 'pi-acp-snapshot-'))
+  const cwd = join(root, 'project')
+  mkdirSync(cwd)
+  const previous = process.env.PI_ACP_READ_COMMAND
+  const command = join(root, 'reader with spaces.cjs')
+  writeFileSync(command, `#!${process.execPath}\n${body}\n`, { mode: 0o755 })
+  process.env.PI_ACP_READ_COMMAND = command
+  t.after(() => {
+    if (previous === undefined) delete process.env.PI_ACP_READ_COMMAND
+    else process.env.PI_ACP_READ_COMMAND = previous
+    rmSync(root, { recursive: true, force: true })
+  })
+  return { root, cwd, command }
+}
+
+test('reader invokes configured executable with exact cwd and single path argument, without shell', t => {
+  const f = fixture(t, `process.stdout.write(JSON.stringify({cwd: process.cwd(), args: process.argv.slice(2)}))`)
+  const path = 'a; $(echo should-not-run).txt'
+  writeFileSync(join(f.cwd, path), 'fixture')
+  assert.deepEqual(JSON.parse(readProjectSnapshot(f.cwd, path)!), { cwd: f.cwd, args: [path] })
+})
+
+test('status44 is missing, status0 preserves exact UTF8, all other failures throw', t => {
+  const f = fixture(
+    t,
+    `if (process.argv[2] === 'missing') process.exit(44); if (process.argv[2] === 'error') process.exit(45); process.stdout.write('héllo\\n\\n')`
+  )
+  assert.equal(readProjectSnapshot(f.cwd, 'missing'), null)
+  assert.equal(readProjectSnapshot(f.cwd, 'file'), 'héllo\n\n')
+  assert.throws(() => readProjectSnapshot(f.cwd, 'error'), /failed/)
+})
+
+test('outside-project symlink is rejected before helper execution', t => {
+  const f = fixture(t, `throw new Error('must not execute')`)
+  const outside = join(f.root, 'host-only')
+  writeFileSync(outside, 'host-only bytes')
+  symlinkSync(outside, join(f.cwd, 'escape'))
+  assert.throws(() => readProjectSnapshot(f.cwd, 'escape'), /outside project/)
+})
+
+test('unset reader disables snapshots and never falls back to host file contents', async t => {
+  const f = fixture(t, `throw new Error('must not run')`)
+  writeFileSync(join(f.cwd, 'file'), 'host-only bytes')
+  delete process.env.PI_ACP_READ_COMMAND
+  assert.throws(() => readProjectSnapshot(f.cwd, 'file'), /unavailable/)
+  const proc = new FakePiRpcProcess()
+  const conn = new FakeAgentSideConnection()
+  new PiAcpSession({
+    sessionId: 's',
+    cwd: f.cwd,
+    mcpServers: [],
+    proc: proc as unknown as PiRpcProcess,
+    conn: asAgentConn(conn)
+  })
+  proc.emit({ type: 'tool_execution_start', toolCallId: 'edit', toolName: 'edit', args: { path: 'file' } })
+  proc.emit({
+    type: 'tool_execution_end',
+    toolCallId: 'edit',
+    isError: false,
+    result: { content: [{ type: 'text', text: 'ok' }] }
+  })
+  await new Promise(resolve => setImmediate(resolve))
+  assert.ok(!JSON.stringify(conn.updates).includes('host-only bytes'))
+  assert.ok(!JSON.stringify(conn.updates).includes('"type":"diff"'))
+})
+
+test('ancestor swap after canonical check cannot trigger a host-read fallback', async t => {
+  const f = fixture(
+    t,
+    `const fs = require('node:fs'); const path = require('node:path'); fs.renameSync('dir', 'original-dir'); fs.symlinkSync(path.resolve('..', 'outside'), 'dir'); process.exit(1)`
+  )
+  mkdirSync(join(f.cwd, 'dir'))
+  writeFileSync(join(f.cwd, 'dir', 'file'), 'project bytes')
+  mkdirSync(join(f.root, 'outside'))
+  writeFileSync(join(f.root, 'outside', 'file'), 'host-only bytes')
+  const proc = new FakePiRpcProcess()
+  const conn = new FakeAgentSideConnection()
+  new PiAcpSession({
+    sessionId: 's',
+    cwd: f.cwd,
+    mcpServers: [],
+    proc: proc as unknown as PiRpcProcess,
+    conn: asAgentConn(conn)
+  })
+  proc.emit({ type: 'tool_execution_start', toolCallId: 'edit', toolName: 'edit', args: { path: 'dir/file' } })
+  proc.emit({
+    type: 'tool_execution_end',
+    toolCallId: 'edit',
+    isError: false,
+    result: { content: [{ type: 'text', text: 'ok' }] }
+  })
+  await new Promise(resolve => setImmediate(resolve))
+  assert.ok(!JSON.stringify(conn.updates).includes('host-only bytes'))
+  assert.ok(!JSON.stringify(conn.updates).includes('"type":"diff"'))
+})
