@@ -0,0 +1,25 @@
+import { before, after } from 'node:test'
+import { mkdtempSync, writeFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+// Test fixture only; production snapshots must use the project's sandbox launcher.
+export function installMockSnapshotReader(): void {
+  let dir: string
+  const previous = process.env.PI_ACP_READ_COMMAND
+  before(() => {
+    dir = mkdtempSync(join(tmpdir(), 'pi-acp-reader-'))
+    const command = join(dir, 'read.cjs')
+    writeFileSync(
+      command,
+      `#!${process.execPath}\nconst fs = require('node:fs'); const path = require('node:path');\ntry { const target = fs.realpathSync(path.resolve(process.cwd(), process.argv[2])); const relative = path.relative(fs.realpathSync(process.cwd()), target); if (relative === '..' || relative.startsWith('../') || path.isAbsolute(relative)) process.exit(1); process.stdout.write(fs.readFileSync(target)); } catch (e) { process.exit(e.code === 'ENOENT' ? 44 : 1); }\n`,
+      { mode: 0o755 }
+    )
+    process.env.PI_ACP_READ_COMMAND = command
+  })
+  after(() => {
+    if (previous === undefined) delete process.env.PI_ACP_READ_COMMAND
+    else process.env.PI_ACP_READ_COMMAND = previous
+    rmSync(dir, { recursive: true, force: true })
+  })
+}
diff --git a/test/unit/native-forms-plans.test.ts b/test/unit/native-forms-plans.test.ts
new file mode 100644
index 0000000..f15f99a
--- /dev/null
+++ b/test/unit/native-forms-plans.test.ts
@@ -0,0 +1,200 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import type { AgentSideConnection, CreateElicitationResponse } from '@agentclientprotocol/sdk'
+import { PiAcpSession } from '../../src/acp/session.js'
+import type { PiRpcProcess } from '../../src/pi-rpc/process.js'
+import { FakeAgentSideConnection, FakePiRpcProcess } from '../helpers/fakes.js'
+import { todoPlan, replayTodoPlan } from '../../src/acp/translate/todo.js'
+
+const tick = () => new Promise(resolve => setImmediate(resolve))
+const schema = { type: 'object', properties: { answer: { type: 'boolean' } }, required: ['answer'] }
+function setup(supportsForms = true) {
+  const proc = new FakePiRpcProcess()
+  const conn = new FakeAgentSideConnection()
+  const requests: unknown[] = []
+  let respond = async (): Promise<CreateElicitationResponse> => ({ action: 'accept', content: { answer: true } })
+  let close!: () => void
+  const client = Object.assign(conn, {
+    closed: new Promise<void>(resolve => {
+      close = resolve
+    }),
+    unstable_createElicitation: async (params: unknown) => {
+      requests.push(params)
+      return respond()
+    }
+  })
+  const session = new PiAcpSession({
+    sessionId: 'session',
+    cwd: '/tmp',
+    mcpServers: [],
+    proc: proc as unknown as PiRpcProcess,
+    conn: client as unknown as AgentSideConnection,
+    supportsForms
+  })
+  const form = () =>
+    proc.emit({
+      type: 'extension_ui_request',
+      id: 'form',
+      method: 'editor',
+      title: '__pi_acp_form_v1__',
+      prefill: JSON.stringify({ message: 'Question', requestedSchema: schema })
+    })
+  return {
+    proc,
+    conn,
+    requests,
+    session,
+    form,
+    close,
+    setResponse: (fn: typeof respond) => {
+      respond = fn
+    }
+  }
+}
+
+test('semantic editor forms use session-scoped elicitation and return JSON', async () => {
+  const s = setup()
+  s.form()
+  await tick()
+  assert.deepEqual(s.requests, [{ mode: 'form', sessionId: 'session', message: 'Question', requestedSchema: schema }])
+  assert.deepEqual(s.proc.extensionUiResponses, [{ id: 'form', value: '{"answer":true}' }])
+})
+
+test('semantic choice annotations survive schema validation', async () => {
+  const s = setup()
+  const requestedSchema = {
+    type: 'object',
+    properties: { choice: { type: 'string', oneOf: [{ const: 'yes', title: 'Yes', description: 'Allow once' }] } }
+  }
+  s.proc.emit({
+    type: 'extension_ui_request',
+    id: 'choice',
+    method: 'editor',
+    title: '__pi_acp_form_v1__',
+    prefill: JSON.stringify({ message: 'Pick', requestedSchema })
+  })
+  await tick()
+  assert.deepEqual(s.requests, [{ sessionId: 'session', mode: 'form', message: 'Pick', requestedSchema }])
+})
+
+test('disposing a session cancels its form before disposing Pi', async () => {
+  const s = setup()
+  let disposed = false
+  Object.assign(s.proc, {
+    dispose: () => {
+      assert.equal(s.proc.extensionUiResponses.length, 1)
+      disposed = true
+    }
+  })
+  s.setResponse(() => new Promise(() => {}))
+  s.form()
+  await tick()
+  s.session.dispose()
+  await tick()
+  assert.ok(disposed)
+  assert.deepEqual(s.proc.extensionUiResponses, [{ id: 'form', cancelled: true }])
+})
+
+for (const action of ['decline', 'cancel'] as const)
+  test(`${action} cancels Pi dialog`, async () => {
+    const s = setup()
+    s.setResponse(async () => ({ action }))
+    s.form()
+    await tick()
+    assert.deepEqual(s.proc.extensionUiResponses, [{ id: 'form', cancelled: true }])
+  })
+
+test('unsupported, malformed and disconnected forms always cancel', async () => {
+  const unsupported = setup(false)
+  unsupported.form()
+  await tick()
+  assert.equal(unsupported.requests.length, 0)
+  assert.ok(unsupported.conn.updates.some(m => m.update.sessionUpdate === 'agent_message_chunk'))
+  assert.deepEqual(unsupported.proc.extensionUiResponses, [{ id: 'form', cancelled: true }])
+  const broken = setup()
+  broken.setResponse(async () => {
+    throw new Error('connection lost')
+  })
+  broken.form()
+  await tick()
+  assert.deepEqual(broken.proc.extensionUiResponses, [{ id: 'form', cancelled: true }])
+  const malformed = setup()
+  malformed.proc.emit({
+    type: 'extension_ui_request',
+    method: 'editor',
+    id: 'form',
+    title: '__pi_acp_form_v1__',
+    prefill: '{}'
+  })
+  await tick()
+  assert.deepEqual(malformed.proc.extensionUiResponses, [{ id: 'form', cancelled: true }])
+})
+
+for (const method of ['input', 'editor'])
+  test(`${method} bridges plain text`, async () => {
+    const s = setup()
+    s.setResponse(async () => ({ action: 'accept', content: { value: 'hello' } }))
+    s.proc.emit({ type: 'extension_ui_request', id: 'text', method, title: 'Text' })
+    await tick()
+    assert.deepEqual(s.proc.extensionUiResponses, [{ id: 'text', value: 'hello' }])
+  })
+
+for (const disconnect of [false, true])
+  test(`pending form cancellation (${disconnect ? 'disconnect' : 'ACP cancel'}) ignores late acceptance`, async () => {
+    const s = setup()
+    let resolve!: (response: CreateElicitationResponse) => void
+    s.setResponse(
+      () =>
+        new Promise(r => {
+          resolve = r
+        })
+    )
+    s.form()
+    await tick()
+    if (disconnect) s.close()
+    else await s.session.cancel()
+    await tick()
+    assert.deepEqual(s.proc.extensionUiResponses, [{ id: 'form', cancelled: true }])
+    resolve({ action: 'accept', content: { answer: true } })
+    await tick()
+    assert.equal(s.proc.extensionUiResponses.length, 1)
+  })
+
+const result = { details: { tasks: [{ subject: 'Do it', status: 'in_progress' }] } }
+test('live successful todo publishes a plan; failure preserves plan; empty clears it', async () => {
+  const s = setup()
+  for (const [id, data, isError] of [
+    ['ok', result, false],
+    ['bad', result, true],
+    ['clear', { details: { tasks: [] } }, false]
+  ] as const) {
+    s.proc.emit({ type: 'tool_execution_end', toolCallId: id, toolName: 'todo', result: data, isError })
+  }
+  await tick()
+  const plans = s.conn.updates.filter(m => m.update.sessionUpdate === 'plan').map(m => m.update)
+  assert.deepEqual(plans, [todoPlan(result), { sessionUpdate: 'plan', entries: [] }])
+})
+
+test('replay follows active ancestry through compaction, ignores failed and abandoned todo', () => {
+  const todo = (id: string, parentId: string | null, tasks = result, isError = false) => ({
+    id,
+    parentId,
+    type: 'message',
+    message: { role: 'toolResult', toolName: 'todo', ...tasks, isError }
+  })
+  const entries = [
+    todo('old', null),
+    todo('abandoned', 'old', { details: { tasks: [] } }),
+    { id: 'compaction', parentId: 'old', type: 'compaction' },
+    todo('failed', 'compaction', { details: { tasks: [] } }, true)
+  ]
+  assert.deepEqual(replayTodoPlan({ entries, leafId: 'failed' }), todoPlan(result))
+  assert.deepEqual(replayTodoPlan({ entries, leafId: 'abandoned' }), { sessionUpdate: 'plan', entries: [] })
+  assert.equal(replayTodoPlan({ entries, leafId: null }), null)
+})
+
+test('handled extension prompt settles without agent_settled', async () => {
+  const s = setup()
+  s.proc.prompt = async () => ({ disposition: 'handled' }) as never
+  assert.equal(await s.session.prompt('/answer'), 'end_turn')
+})
