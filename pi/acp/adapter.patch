index 0000000..f01f573
--- /dev/null
+++ b/test/unit/session-reload-lifecycle.test.ts
@@ -0,0 +1,126 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { PiAcpAgent } from '../../src/acp/agent.js'
+import { PiAcpSession, SessionManager } from '../../src/acp/session.js'
+import { PiRpcProcess } from '../../src/pi-rpc/process.js'
+import { mkdtempSync, writeFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import type { ChildProcess } from 'node:child_process'
+import type { AgentSideConnection } from '@agentclientprotocol/sdk'
+import { FakeAgentSideConnection, FakePiRpcProcess } from '../helpers/fakes.js'
+
+const tick = () => new Promise(resolve => setImmediate(resolve))
+function setup() {
+  const proc = new FakePiRpcProcess()
+  const conn = Object.assign(new FakeAgentSideConnection(), {
+    unstable_createElicitation: () => new Promise(() => {})
+  })
+  const session = new PiAcpSession({
+    sessionId: 's',
+    cwd: '/tmp',
+    mcpServers: [],
+    supportsForms: true,
+    proc: proc as unknown as PiRpcProcess,
+    conn: conn as unknown as AgentSideConnection
+  })
+  const sessions = new SessionManager()
+  ;(sessions as unknown as { sessions: Map<string, PiAcpSession> }).sessions.set('s', session)
+  const agent = new PiAcpAgent(conn as unknown as AgentSideConnection)
+  const internals = agent as unknown as {
+    sessions: SessionManager
+    store: unknown
+    restoreSession: (id: string) => Promise<PiAcpSession>
+  }
+  internals.sessions = sessions
+  internals.store = { get: () => ({ cwd: '/tmp', sessionFile: '/tmp/test-session.jsonl' }) }
+  return { proc, session, sessions, agent, internals }
+}
+
+test('reload with a pending form is rejected without closing or replacing the process', async () => {
+  const s = setup()
+  let disposed = false
+  let restored = false
+  Object.assign(s.proc, {
+    dispose: () => {
+      disposed = true
+    }
+  })
+  s.internals.restoreSession = async () => {
+    restored = true
+    throw new Error('unexpected restore')
+  }
+  s.proc.emit({
+    type: 'extension_ui_request',
+    id: 'form',
+    method: 'editor',
+    title: '__pi_acp_form_v1__',
+    prefill: JSON.stringify({ message: 'Question', requestedSchema: { type: 'object', properties: {} } })
+  })
+  await tick()
+  await assert.rejects(s.agent.loadSession({ sessionId: 's', cwd: '/tmp', mcpServers: [] }), /invalid params/i)
+  assert.equal(disposed, false)
+  assert.equal(restored, false)
+  assert.deepEqual(s.proc.extensionUiResponses, [])
+  await s.sessions.close('s')
+  assert.deepEqual(s.proc.extensionUiResponses, [{ id: 'form', cancelled: true }])
+})
+
+test('idle reload signals synchronously but does not restore until actual process exit', async () => {
+  const s = setup()
+  let signalled = false
+  let restored = false
+  let exit!: () => void
+  Object.assign(s.proc, {
+    dispose: () => {
+      signalled = true
+    },
+    disposeAndWait: () =>
+      new Promise<void>(resolve => {
+        exit = resolve
+      })
+  })
+  s.internals.restoreSession = async () => {
+    restored = true
+    throw new Error('restore reached')
+  }
+  const loading = s.agent.loadSession({ sessionId: 's', cwd: '/tmp', mcpServers: [] })
+  assert.equal(signalled, true)
+  await tick()
+  assert.equal(restored, false)
+  assert.equal(s.sessions.maybeGet('s'), s.session)
+  exit()
+  await assert.rejects(loading, /restore reached/)
+  assert.equal(restored, true)
+  assert.equal(s.sessions.maybeGet('s'), undefined)
+})
+
+test('disposeAndWait waits for child exit, not just successful delivery of SIGTERM', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'pi-acp-exit-'))
+  const command = join(dir, 'pi.cjs')
+  writeFileSync(
+    command,
+    `#!${process.execPath}\nprocess.on('SIGTERM', () => setTimeout(() => process.exit(0), 100));\nrequire('node:readline').createInterface({input:process.stdin}).on('line', line => { const req = JSON.parse(line); console.log(JSON.stringify({type:'response', id:req.id, command:req.type, success:true, data:{}})); });\n`,
+    { mode: 0o755 }
+  )
+  try {
+    const proc = await PiRpcProcess.spawn({ cwd: dir, piCommand: command })
+    const child = (proc as unknown as { child: ChildProcess }).child
+    const closing = proc.disposeAndWait()
+    assert.equal(child.killed, true)
+    assert.equal(child.exitCode, null)
+    await closing
+    assert.equal(child.exitCode, 0)
+  } finally {
+    rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+test('close resolves both active and queued turns instead of leaving ACP requests pending', async () => {
+  const s = setup()
+  const active = s.session.prompt('first')
+  const queued = s.session.prompt('second')
+  assert.ok(s.session.isBusy())
+  await s.sessions.close('s')
+  assert.deepEqual(await Promise.all([active, queued]), ['cancelled', 'cancelled'])
+})
