	"compilerOptions": {
		"module": "esnext",
		"target": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"typeRoots": [
			"/etc/profiles/per-user/dzervas/lib/node_modules/pi-monorepo/node_modules/@types",
			"/home/dzervas/.pi/agent/node_modules/@types",
