{
	"settings": {
		"showStatusIcon": true,
		"mcpFooterStatus": "off",
		"hostConfigDiscovery": "prompt",
		"approveTools": ["github_delete_*", "notion_update_*"],
		"elicitation": true
	},
	"mcpServers": {
		"mcp-gateway": {
			"command": "docker",
			"args": ["mcp", "gateway", "run", "--profile", "pi"]
		},

		"context7": {
			"url": "https://mcp.context7.com/mcp/oauth",
			"auth": "oauth"
		}
	}
}
